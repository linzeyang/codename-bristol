# ── 服务端口 ─────────────────────────────────────────────
PORT=3001

# ── 数据库 ───────────────────────────────────────────────
# 本地开发默认连接 compose 中的 db（仅监听 127.0.0.1）
DATABASE_URL=postgres://postgres@localhost:5432/shengyu
POSTGRES_DB=shengyu
POSTGRES_USER=postgres
# 生产环境必须设置强密码，并同步修改 DATABASE_URL
POSTGRES_PASSWORD=

# ── 安全 ─────────────────────────────────────────────────
# 留空时 API 启动会生成临时随机密钥（重启后会话失效），生产必须设置
JWT_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ── 种子 ─────────────────────────────────────────────────
# 数据库目录为空时自动写入示例数据
SEED_ON_EMPTY=true

# ── Docker Compose ───────────────────────────────────────
WEB_PORT=8080
# 本机已有 PostgreSQL 占用 5432 时改为其他端口，例如 5433
DB_PORT=5432

# ── 可选：OpenAI 兼容 LLM 增强（不配置则使用离线意图引擎）──
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=8000